# Shell and Python scripts run on Linux/WSL. Force LF so a Windows-side edit
# cannot store CRLF and break the shebang (/usr/bin/env: 'bash\r').
*.sh  text eol=lf
*.py  text eol=lf
# Game data the console reads byte for byte (BOMBREG.PEM must stay CRLF).
scripts/assets/bomb/BOMBREG.PEM -text
scripts/assets/mingol/ROOT_ED.PEM -text
# PSBBN's Feega screens, installed onto __linux.4 byte for byte (Sony's mixed CRLF/LF kept).
scripts/assets/feega/** -text
